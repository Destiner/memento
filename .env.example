# Configuration names only. Set actual values privately; never commit .env files.
NODE_ENV=production
MEMENTO_PUBLIC_ORIGIN=https://memento.example.com
MEMENTO_DATA_DIR=/var/data/memento
PORT=3000
# Comma-separated exact verified addresses, not domains or wildcards.
AUTH_ALLOWED_EMAILS=
BETTER_AUTH_SECRET=
# At least one complete pair is required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
