{
  "name": "memento",
  "version": "0.7.0",
  "description": "Coding-agent memory layer",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Destiner/memento.git"
  },
  "bugs": {
    "url": "https://github.com/Destiner/memento/issues"
  },
  "homepage": "https://github.com/Destiner/memento#readme",
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "memento": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run typecheck:cloudflare && bun run typecheck:harness && bun run typecheck:retrospective && bun run test && bun run test:operator && bun run test:harness && bun run test:retrospective && bun run build",
    "typecheck": "tsc --noEmit",
    "typecheck:cloudflare": "tsc -p cloudflare/tsconfig.json && tsc -p cloudflare/operator/tsconfig.json",
    "test:operator": "vitest run --config cloudflare/operator/vitest.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "report": "bun run src/report/main.ts",
    "retrospective": "tsx retrospective/main.ts",
    "harness": "bun run test-harness/runner/index.ts",
    "harness:report": "bun run test-harness/runner/report-cli.ts",
    "typecheck:retrospective": "tsc -p retrospective/tsconfig.json",
    "test:retrospective": "vitest run --config retrospective/vitest.config.ts",
    "typecheck:harness": "tsc -p test-harness/tsconfig.json",
    "test:harness": "vitest run --config test-harness/vitest.config.ts"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "1.7.17",
    "@better-auth/oauth-provider": "1.7.17",
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/sdk": "^1.19.1",
    "better-auth": "1.7.17",
    "hono": "4.13.17",
    "kysely": "^0.29.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.10.1",
    "esbuild": "0.28.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "miniflare": "5.20261123.1-beta",
    "prettier": "^3.6.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.168.0"
  }
}
